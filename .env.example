# Copy to .env.local for development, or set these in Render → Environment.
# Both values come from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://vranxktkubjtzwpdjtah.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_pIjEZntW45YouqEwjiEIhw_l_R4ui7J

# For local dev with Google OAuth, add this to your Supabase Auth URL config:
# http://127.0.0.1:5173/auth/callback

# Optional: Google Ad Manager rewarded ad unit for "watch an ad, earn tokens",
# e.g. /1234567/rewarded_tokens. Without it, your own ads (admin → Ads) are shown instead.
VITE_GAM_REWARDED_UNIT=

# Google AdSense: publisher id (AdSense → Account → Settings) and a responsive display ad unit id.
# Leave empty to show no ads.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

{
  "name": "7games",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:app": "tsc -b && vite build --mode app",
    "cap:sync": "npm run build:app && npx cap sync android",
    "android": "npm run cap:sync && npx cap open android",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "app:assets": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/native-purchases": "^8.9.16",
    "@dicebear/avataaars": "^9.4.2",
    "@dicebear/bottts": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@dicebear/lorelei": "^9.4.2",
    "@dicebear/notionists": "^9.4.2",
    "@dicebear/pixel-art": "^9.4.2",
    "@dicebear/thumbs": "^9.4.2",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
